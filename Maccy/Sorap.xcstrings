    "board.empty.message %lld" : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld item will be permanently deleted. This can't be undone."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld items will be permanently deleted. This can't be undone."
                }
              }
            }
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항목 %lld개가 완전히 삭제됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "ja" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "項目%lld件が完全に削除されます。この操作は元に戻せません。"
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld 个项目将被永久删除，且无法撤消。"
                }
              }
            }
          }
        },
        "zh-Hant" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld 個項目將被永久刪除，且無法還原。"
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Se eliminará %lld elemento de forma permanente. No se puede deshacer."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Se eliminarán %lld elementos de forma permanente. No se puede deshacer."
